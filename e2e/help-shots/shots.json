[
  {
    "name": "system-population",
    "scene": "own-system",
    "selector": ".system-population",
    "padding": 8,
    "alt": "The Population box of a system: growth, mobilized workforce, housing and stability",
    "marks": {
      "growth": { "selector": ".system-population .box-line.header", "ownText": true },
      "growth-bar": ".system-population .progres-container",
      "workforce": ".system-population .box-line:not(.header) .yield-box >> nth=0",
      "housing": ".system-population .box-line:not(.header) .yield-box >> nth=1",
      "stability": ".system-population .box-line:not(.header) .yield-box >> nth=2"
    }
  },
  {
    "name": "system-population-status",
    "scene": "empire",
    "openSystem": "destabilized",
    "selector": ".system-info .system-content-group:has(.system-content-group-pop-state)",
    "padding": 8,
    "alt": "The population status bar: productivity by stability band, current band highlighted",
    "marks": {
      "current": ".system-content-group-pop-state .pop-state-item.is-active"
    }
  },
  {
    "name": "system-bodies",
    "scene": "own-system",
    "selector": [
      ".system-content-scrollbar .system-content-group:has(.system-content-group-item) >> nth=0",
      ".system-content-scrollbar .system-content-group:has(.system-content-group-item) >> nth=1"
    ],
    "padding": 0,
    "alt": "The first stellar bodies of a system, with the population of the inhabited planet",
    "marks": {
      "body-population": ".system-content-group-header .potential-item >> nth=0"
    }
  },
  {
    "name": "credit-tooltip",
    "scene": "own-system",
    "prepare": "pin-credit-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The credit breakdown of a system",
    "marks": {
      "taxes": ".tooltip.popover.open .label-value:not(.main):has-text(\"Taxes\")",
      "mobility": { "selector": ".tooltip.popover.open .label-value:not(.main):has-text(\"Mobility bonus\")", "optional": true },
      "buildings": { "selector": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Buildings\"))", "optional": true }
    }
  },
  {
    "name": "stability-tooltip",
    "scene": "own-system",
    "prepare": "pin-stability-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The stability breakdown of a system",
    "marks": {
      "population": ".tooltip.popover.open .label-value:not(.main):has-text(\"Population\")",
      "buildings": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Buildings\"))"
    }
  },
  {
    "name": "building-card-mobilized",
    "scene": "own-system",
    "prepare": "hover-built-building",
    "selector": ".system-building-card .card-container",
    "padding": 8,
    "alt": "A building card showing how many workers the building mobilizes",
    "marks": {
      "mobilized": { "selector": ".system-building-card .card-header-content .title-small", "ownText": true }
    }
  },
  {
    "name": "system-properties",
    "scene": "own-system",
    "selector": [
      ".system-properties",
      ".system-properties .box-aside.left",
      ".system-properties .box-aside.right",
      ".system-properties .production-box",
      ".system-properties .governor-box"
    ],
    "padding": 8,
    "alt": "The system header: defense, owner, star type, and the system's credit, technology and ideology output",
    "marks": {
      "defense": ".system-properties .box-aside.left",
      "owner": ".system-properties .owner",
      "star": ".system-properties .star",
      "credit": ".system-properties .yields .yield-box >> nth=0",
      "technology": ".system-properties .yields .yield-box >> nth=1",
      "ideology": ".system-properties .yields .yield-box >> nth=2"
    }
  },
  {
    "name": "production-tooltip",
    "scene": "empire",
    "openSystem": "home",
    "prepare": "pin-production-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 8,
    "alt": "The production breakdown of a system",
    "marks": {
      "initial": ".tooltip.popover.open .label-value:not(.main):has-text(\"Initial value\")",
      "buildings": { "selector": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Buildings\"))", "optional": true }
    }
  },
  {
    "name": "defense-tooltip",
    "scene": "own-system",
    "prepare": "hover-defense-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 8,
    "alt": "The defense breakdown of a system",
    "marks": {
      "population": ".tooltip.popover.open .label-value:not(.main):has-text(\"Population\")",
      "buildings": { "selector": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Buildings\"))", "optional": true }
    }
  },
  {
    "name": "system-body",
    "scene": "own-system",
    "selector": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0",
    "padding": 8,
    "alt": "The inhabited planet in the bodies list: its three potentials and its building tiles",
    "marks": {
      "potentials": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-info-potentials",
      "tiles": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles",
      "infrastructure": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile.is-important"
    }
  },
  {
    "name": "bottombar-limits",
    "scene": "own-system",
    "selector": [
      ".navbar.bottom .navbar-group-buttons.left .navbar-maxed-value >> nth=0",
      ".navbar.bottom .navbar-group-buttons.left .navbar-maxed-value >> nth=1"
    ],
    "padding": 8,
    "alt": "The systems and dominions counters in the bottom bar",
    "marks": {
      "systems": ".navbar.bottom .navbar-group-buttons.left .navbar-maxed-value >> nth=0",
      "dominions": ".navbar.bottom .navbar-group-buttons.left .navbar-maxed-value >> nth=1"
    }
  },
  {
    "name": "system-state",
    "scene": "own-system",
    "prepare": "open-state-tab",
    "selector": [
      ".system-content-scrollbar .system-content-group:has(.system-content-group-info)",
      ".system-content-scrollbar .system-content-group:has(> .button)"
    ],
    "padding": 8,
    "alt": "The state tab of a system: who claims it, population productivity, and the liberate and abandon operations",
    "marks": {
      "status": ".system-content-scrollbar .system-content-group-info",
      "liberate": ".system-content-scrollbar .system-content-group > .button >> nth=0",
      "abandon": ".system-content-scrollbar .system-content-group > .button >> nth=1"
    }
  },
  {
    "name": "dominion-properties",
    "scene": "empire",
    "openSystem": "dominion",
    "selector": [
      ".system-properties",
      { "selector": ".system-properties .box-aside.left", "optional": true },
      { "selector": ".system-properties .box-aside.right", "optional": true },
      { "selector": ".system-properties .production-box", "optional": true },
      { "selector": ".system-properties .governor-box", "optional": true }
    ],
    "padding": 8,
    "alt": "The header of one of your dominions: its owner line names you, and the half marker shows it is a dominion",
    "marks": {
      "owner": ".system-properties .owner"
    }
  },
  {
    "name": "uninhabited-state",
    "scene": "empire",
    "openSystem": "uninhabited",
    "prepare": "scroll-state-into-view",
    "selector": ".system-content-scrollbar .system-content-group:has(.system-content-group-info)",
    "padding": 8,
    "alt": "The state of an uninhabited system: nobody claims it yet",
    "marks": {
      "status": ".system-content-scrollbar .system-content-group-info"
    }
  },
  {
    "name": "dominion-state",
    "scene": "empire",
    "openSystem": "dominion",
    "prepare": "open-state-tab",
    "selector": [
      ".system-content-scrollbar .system-content-group:has(.system-content-group-info)",
      ".system-content-scrollbar .system-content-group:has(> .button)"
    ],
    "padding": 8,
    "alt": "The state tab of a dominion: who claims it, population productivity, and the administer and abandon operations",
    "marks": {
      "status": ".system-content-scrollbar .system-content-group-info",
      "administer": ".system-content-scrollbar .system-content-group > .button >> nth=0",
      "abandon": ".system-content-scrollbar .system-content-group > .button >> nth=1"
    }
  },
  {
    "name": "empire-credit-tooltip",
    "scene": "empire",
    "prepare": "pin-empire-credit-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The empire's credit income breakdown from the bottom bar, with a line per system and per dominion",
    "marks": {
      "systems": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Systems\"))",
      "dominions": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Dominions\"))"
    }
  },
  {
    "name": "stability-tooltip-destabilized",
    "scene": "empire",
    "openSystem": "destabilized",
    "prepare": "pin-stability-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The stability breakdown of a destabilized system, with the Destabilization line under temporary penalties",
    "marks": {
      "temporary-penalties": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Temporary penalties\"))"
    }
  },
  {
    "name": "technology-empire-tooltip",
    "scene": "empire",
    "disabled": "ResourceDetail drops zero-value lines, and no fixture system or dominion makes technology (no technology buildings yet), so the Systems and Dominions groups never appear. Needs a scene with built technology buildings.",
    "prepare": "pin-empire-technology-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The empire's technology income breakdown from the bottom bar, with a line per system and per dominion",
    "marks": {
      "systems": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Systems\"))",
      "dominions": ".tooltip.popover.open .resource-detail > div:has(> .label-value-subtitle:has-text(\"Dominions\"))"
    }
  },
  {
    "name": "autonomous-state",
    "scene": "empire",
    "openSystem": "autonomous",
    "prepare": "open-state-tab",
    "selector": [
      ".system-content-scrollbar .system-content-group:has(.system-content-group-info)",
      { "selector": ".system-content-scrollbar .system-content-group:has(.system-content-group-pop-state)", "optional": true }
    ],
    "padding": 8,
    "alt": "The state tab of an autonomous system: nobody claims it, and its population productivity",
    "marks": {
      "status": ".system-content-scrollbar .system-content-group-info"
    }
  },
  {
    "name": "bottombar-limits-tooltip",
    "scene": "empire",
    "prepare": "hover-systems-limit-popover",
    "selector": ".tooltip.popover.open .tooltip-inner",
    "padding": 2,
    "alt": "The System Limit breakdown shown when hovering the Systems counter in the bottom bar",
    "marks": {
      "limit": ".tooltip.popover.open .label-value.main"
    }
  },
  {
    "name": "build-menu",
    "scene": "empire",
    "openSystem": "home",
    "prepare": "open-build-menu",
    "selector": [
      ".system-production",
      ".system-production-building-card .card-container"
    ],
    "padding": 8,
    "alt": "The build menu of a free tile, with the card of a Limited building that is greyed out because the planet already has one",
    "marks": {
      "locked": ".system-production-content .tile.has-dashed-background >> nth=0",
      "disabled": ".system-production-content .tile[data-help-shot=\"hovered\"]",
      "limited": ".system-production-building-card .card-illustration .toast",
      "cost": ".system-production-building-card .card-cost"
    }
  },
  {
    "name": "body-tiles-actions",
    "scene": "empire",
    "openSystem": "home",
    "prepare": "hover-upgradable-tile",
    "selector": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0",
    "padding": 8,
    "alt": "The tiles of a planet: a building with its Upgrade and Destroy buttons, a damaged building with its Repair button, and buildings under construction",
    "marks": {
      "upgrade": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile:not(.has-dashed-background) > .tile-toast.top.left",
      "destroy": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile:not(.has-dashed-background):has(.tile-toast.top.left) > .tile-toast.bottom.right",
      "damaged": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile.has-dashed-background:has(.tile-level)",
      "repair": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile.has-dashed-background > .tile-toast.top.left",
      "construction": ".system-content-scrollbar .system-content-group:has(.system-content-group-header .secondary .potential-item) >> nth=0 >> .body-tiles .tile > .tile-toast.bottom.left >> nth=0"
    }
  },
  {
    "name": "production-queue",
    "scene": "empire",
    "openSystem": "home",
    "prepare": "open-production-queue",
    "selector": ".system-production-queue",
    "padding": 8,
    "alt": "The construction queue of a system: each order with its estimated finish time, and the cancel button of the hovered order",
    "marks": {
      "first": ".system-production-queue .card-container >> nth=0",
      "finish-time": ".system-production-queue .card-container >> nth=0 >> .title-small",
      "cancel": ".system-production-queue .card-container >> nth=0 >> .card-header-toast"
    }
  },
  {
    "name": "production-box-queue",
    "scene": "empire",
    "openSystem": "home",
    "prepare": "hide-system-info",
    "selector": [
      ".system-properties .production-box",
      ".system-properties .production-box .round-icon",
      ".system-properties .production-box .production-counter"
    ],
    "padding": 8,
    "alt": "The production box of a system: the order being built with its progress ring, the number of orders behind it, and the time left",
    "marks": {
      "progress": ".system-properties .production-box .round-icon",
      "counter": ".system-properties .production-box .production-counter"
    }
  },
  {
    "name": "foreign-tiles",
    "scene": "empire",
    "openSystem": "autonomous",
    "selector": ".system-content-scrollbar .system-content-group:has(.body-tiles .tile-level) >> nth=0",
    "padding": 8,
    "alt": "The tiles of a system you have little visibility on: you see which tiles hold a building, but not which building or its level",
    "marks": {
      "hidden-building": ".system-content-scrollbar .system-content-group:has(.body-tiles .tile-level) >> nth=0 >> .body-tiles .tile:has(.tile-level) >> nth=0"
    }
  }
]
