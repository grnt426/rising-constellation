{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BuildCacheBucketProvision",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::rc-build-cache-553872001542"
    },
    {
      "Sid": "BuildCacheObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::rc-build-cache-553872001542/*"
    }
  ]
}
