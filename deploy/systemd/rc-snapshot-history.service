[Unit]
Description=Hourly snapshot history of official Legacy matches (packed per match day, kept in S3)
Documentation=file:/usr/local/bin/rc-snapshot-history
Wants=network-online.target
After=network-online.target postgresql.service

# Email the operator (contact@tetrarchyfalls.com) when a run fails.
# See deploy/bin/rc-alert-mail.
OnFailure=rc-alert@%n.service

[Service]
Type=oneshot
User=rc
Group=rc

# RC_BACKUP_BUCKET. Deliberately NOT /etc/rc/env: the app's dead AWS keys
# would shadow the instance role.
EnvironmentFile=/etc/rc/backup.env

ExecStart=/usr/local/bin/rc-snapshot-history

# Packing a day (~24 snapshots, zstd -19 --long) takes about a minute of
# one core; keep it behind the game.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
