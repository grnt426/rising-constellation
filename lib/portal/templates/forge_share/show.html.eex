<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <title><%= @title %> — Tetrarchy Falls</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="<%= @description %>"/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Tetrarchy Falls"/>
    <meta property="og:title" content="<%= @title %>"/>
    <meta property="og:description" content="<%= @description %>"/>
    <meta property="og:url" content="<%= @share_url %>"/>
    <%= if @image do %>
    <meta property="og:image" content="<%= @image %>"/>
    <meta property="og:image:width" content="400"/>
    <meta property="og:image:height" content="400"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:image" content="<%= @image %>"/>
    <% else %>
    <meta name="twitter:card" content="summary"/>
    <% end %>
    <meta name="twitter:title" content="<%= @title %>"/>
    <meta name="twitter:description" content="<%= @description %>"/>
    <meta name="theme-color" content="#0e1726"/>

    <%# Humans never linger here — straight into the SPA detail page.
        Scrapers don't follow the refresh; they read the tags above. %>
    <meta http-equiv="refresh" content="0;url=<%= @spa_url %>"/>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0e1726;
        color: rgba(255, 255, 255, .85);
        font-family: sans-serif;
        text-align: center;
      }
      a { color: #7fc4ff; }
      img { max-width: 280px; border-radius: 6px; display: block; margin: 20px auto 0; }
    </style>
  </head>
  <body>
    <div>
      <h1><%= @title %></h1>
      <p><%= @description %></p>
      <p><a href="<%= @spa_url %>">Open in Tetrarchy Falls</a></p>
      <%= if @image do %><img src="<%= @image %>" alt=""/><% end %>
    </div>
  </body>
</html>
