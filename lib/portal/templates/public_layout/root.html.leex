<!DOCTYPE html>
<%# The site chrome is English. French content (the help manual's
    ?lang=fr, the About page's French text) carries its own lang=, which
    also stays right when the language changes in place. %>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <%= csrf_meta_tag() %>
    <%= live_title_tag assigns[:page_title] || "Home", suffix: " · Tetrarchy Falls" %>

    <link rel="apple-touch-icon" sizes="180x180" href="<%= Routes.static_path(@conn, "/apple-icon-180x180.png") %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= Routes.static_path(@conn, "/favicon-32x32.png") %>">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= Routes.static_path(@conn, "/favicon-16x16.png") %>">
    <link rel="manifest" href="<%= Routes.static_path(@conn, "/site.webmanifest") %>">

    <link phx-track-static rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/app.css") %>"/>
    <link phx-track-static rel="stylesheet" href="<%= Routes.static_path(@conn, "/fontawesome/css/all.min.css") %>"/>

    <script defer phx-track-static type="text/javascript" src="<%= Routes.static_path(@conn, "/js/app.js") %>"></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <%# Screen-reader live regions for form feedback (app.js announce()).
        They sit in the root layout, which LiveView never patches, so they
        are already in the DOM when a message is written into them. %>
    <div id="a11y-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="a11y-alert" class="sr-only" role="alert" aria-live="assertive" aria-atomic="true"></div>

    <div class="main-container">
      <nav class="navbar top" aria-label="Main">
        <section>
          <%= live_redirect to: Routes.live_path(@conn, Portal.LandingLive), class: "nav-item logo" do %><img src="<%= Routes.static_path(@conn, "/img/logo-icon-white.png") %>" alt="Tetrarchy Falls home"><% end %>
          <%= live_redirect "About", to: Routes.live_path(@conn, Portal.AboutLive), class: "nav-item" %>
          <%= live_redirect "Patch notes", to: Routes.live_path(@conn, Portal.PatchNotesLive), class: "nav-item" %>
          <%= live_redirect "Manual", to: Routes.help_path(@conn, :index), class: "nav-item" %>
        </section>

        <section>
          <%# Plain links, not live_redirect: arriving at /login via a full
              page load puts the form in the initial HTML, which is when
              password managers scan most reliably. %>
          <%= link "Log in", to: Routes.live_path(@conn, Portal.LoginLive), class: "nav-item" %>
          <%= link "Sign up", to: Routes.live_path(@conn, Portal.SignupLive), class: "nav-item" %>
        </section>
      </nav>

      <%# tabindex="-1": the skip link and live navigation (app.js) move
          focus here so reading starts at the page content. %>
      <main id="main" class="content" tabindex="-1">
        <%= @inner_content %>
      </main>

      <footer class="navbar bottom">
        <section>
          <a
            class="nav-item"
            target="_blank"
            rel="noopener"
            aria-label="Discord (opens in a new tab)"
            href="https://discord.gg/svjRtMbNNK">
            <i class="fab fa-discord" aria-hidden="true"></i>
          </a>
          <a
            class="nav-item"
            target="_blank"
            rel="noopener"
            aria-label="Facebook (opens in a new tab)"
            href="https://www.facebook.com/risingconstellation">
            <i class="fab fa-facebook-f" aria-hidden="true"></i>
          </a>
          <a
            class="nav-item"
            target="_blank"
            rel="noopener"
            aria-label="Twitter (opens in a new tab)"
            href="https://twitter.com/rising_const">
            <i class="fab fa-twitter" aria-hidden="true"></i>
          </a>
          <a
            class="nav-item"
            target="_blank"
            rel="noopener"
            aria-label="Instagram (opens in a new tab)"
            href="https://www.instagram.com/rising_constellation_">
            <i class="fab fa-instagram" aria-hidden="true"></i>
          </a>
        </section>
      </footer>
    </div>
  </body>
</html>
