<div class="fluid-container help-container">
  <%= if @page do %>
    <section class="pk-content help-page">
      <nav class="help-breadcrumb">
        <.link patch={Routes.help_path(@socket, :index) <> @link_query}>Manual</.link>
        <span>›</span>
        <span><%= String.capitalize(@page.category) %></span>
      </nav>

      <h1 class="help-title">
        <%= if @page.icon do %>
          <svg class="help-icon help-title-icon" aria-hidden="true"><use href={"#{@sprite}##{Portal.HelpLive.sprite_id(@page.icon)}"} /></svg>
        <% end %>
        <%= @page.title %>
        <%= if @page.status == "draft" do %><span class="help-badge">draft</span><% end %>
      </h1>

      <div class="help-body">
        <%= raw(@html) %>
      </div>

      <%= if @related != [] do %>
        <div class="help-related">
          <h3>Related</h3>
          <ul>
            <%= for {slug, title} <- @related do %>
              <li><.link patch={Routes.help_path(@socket, :show, slug) <> @link_query}><%= title %></.link></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <p class="help-speed">
        Numbers shown for <strong><%= @speed_names[@speed] %></strong> games.
        <%= if @page.speed_sensitive do %>
          Other speeds:
          <%= for other <- Portal.HelpLive.other_speeds(@speed) do %>
            <.link patch={Routes.help_path(@socket, :show, @page.slug, %{speed: other})}><%= @speed_names[other] %></.link>
          <% end %>
        <% else %>
          This page is the same at every speed.
        <% end %>
      </p>
    </section>
  <% else %>
    <section class="pk-content help-page">
      <h1>Manual</h1>
      <p>
        How the game's mechanics work, with the numbers taken from the game itself.
        <%= @page_count %> pages. Numbers shown for <strong><%= @speed_names[@speed] %></strong> games
        <span class="help-speed-inline">(other speeds:
          <%= for other <- Portal.HelpLive.other_speeds(@speed) do %>
            <.link patch={Routes.help_path(@socket, :index, %{speed: other})}><%= @speed_names[other] %></.link>
          <% end %>).
        </span>
      </p>

      <form class="help-search" method="get" action={Routes.help_path(@socket, :index)} phx-change="search" phx-submit="search">
        <%= if @speed != :slow do %><input type="hidden" name="speed" value={@speed} /><% end %>
        <%= if @lang != "en" do %><input type="hidden" name="lang" value={@lang} /><% end %>
        <input type="search" name="q" value={@query} placeholder="Search the manual" autocomplete="off" phx-debounce="200" />
      </form>

      <%= if @results do %>
        <div class="help-results">
          <h2>Results for “<%= @query %>”</h2>
          <%= if @results == [] do %>
            <p>No page matches.</p>
          <% else %>
            <ul>
              <%= for p <- @results do %>
                <li>
                  <.link patch={Routes.help_path(@socket, :show, p.slug) <> @link_query}><%= p.title %></.link>
                  <span class="help-muted"><%= String.capitalize(p.category) %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>

      <div class="help-toc">
        <%= for cat <- @categories do %>
          <h2><%= cat.title %></h2>
          <ul>
            <%= for p <- cat.slugs do %>
              <li><.link patch={Routes.help_path(@socket, :show, p.slug) <> @link_query}><%= p.title %></.link></li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div class="help-glossary">
        <h2>Glossary</h2>
        <dl>
          <%= for entry <- @glossary do %>
            <dt><%= entry.term %></dt>
            <dd><.link patch={Routes.help_path(@socket, :show, entry.slug) <> @link_query}><%= entry.title %></.link></dd>
          <% end %>
        </dl>
      </div>
    </section>
  <% end %>
</div>
